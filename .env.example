# ------------------------------------------------------------------
# Copy this file to `.env` and change the values.
#   Windows:  copy .env.example .env
# `.env` is listed in .gitignore and is NOT included in the ZIP.
# The values below are PLACEHOLDERS ONLY - do not use them as-is.
# ------------------------------------------------------------------

# First manager account (used once by: python -m auth.setup_manager)
MANAGER_USERNAME=bankadmin
MANAGER_PASSWORD=ChangeThisPassword123!
MANAGER_NAME=Bank Administrator

# Random secret for the app (generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))")
APP_SECRET_KEY=replace_with_a_secure_random_secret

# Optional: use a different database file
# BANK_DB_PATH=database/bank_performance.db
